# Copy to `.env` on the box. NEVER commit the real file (architecture.md §5.1).
# Values below are placeholders.

# --- Database ---
POSTGRES_DB=r3
POSTGRES_USER=r3
POSTGRES_PASSWORD=
DATABASE_URL=postgres://r3:@postgres:5432/r3

# --- Sessions (§4.2) ---
# Opaque random session ids in an httpOnly, Secure, SameSite cookie.
SESSION_COOKIE_SECRET=

# --- Web push / VAPID (§4.4) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# --- Cloudflare Tunnel (§4.5) ---
# The only ingress path. Nothing on the box listens on the public internet.
TUNNEL_TOKEN=

# --- App ---
NODE_ENV=production
PORT=3000
# Express `trust proxy` (§4.2). The final hop cloudflared -> Express is plain HTTP,
# so without this Express believes the connection is insecure and refuses to set the
# Secure session cookie. It must also name the cloudflared network on the box, or the
# per-IP brute-force counter sees one address for every request and stops working.
TRUST_PROXY=loopback
TZ=America/Chicago
