{
  "name": "@r3/server",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "dependencies": {
    "express": "^5.2.1",
    "kysely": "^0.29.4",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.22.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/web-push": "^3.6.4",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "migrate:up": "node-pg-migrate up -m migrations --migration-file-language sql -j sql",
    "codegen": "kysely-codegen --dialect postgres --out-file src/db/types.ts --log-level error",
    "test": "vitest run"
  }
}
