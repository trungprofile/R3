archived

# .claude/ ships with the repo so cloud sessions get the same agents,
# commands, and settings. Only per-machine overrides stay local.
.claude/settings.local.json
.claude/**/*.local.*

# Agent worktrees are whole checkouts of this repo living inside it. Without
# this, the lead's `git add -A` after a wave merge would commit every lane's
# entire working tree into phase-1.
.claude/worktrees/

# No trailing slash: worktrees get `node_modules` as a SYMLINK (settings.json
# `worktree.symlinkDirectories`), and git treats a symlink as a file, so a
# `node_modules/` pattern misses it. Every lane's `git add -A` would then commit
# a machine-specific absolute-path symlink, and lanes would collide on it.
node_modules
dist/
build/

# Secrets live in an env file on the box, never committed (§5.1)
.env
.env.*
!.env.example

*.log
.DS_Store

