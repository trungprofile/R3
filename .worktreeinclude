# Gitignored files copied into every worktree Claude Code creates.
#
# Only files that are BOTH listed here and gitignored get copied — tracked files
# arrive with the checkout on their own. Since `.claude/` and `CLAUDE.md` became
# tracked, they no longer belong here: a lane agent gets the doc routing table
# and the agent definitions as part of its worktree automatically.
#
# What remains is genuinely local, so a worktree would otherwise start without it.

# Per-machine permission overrides. Without these a lane agent can hit prompts
# the main checkout was configured never to see.
.claude/settings.local.json

# Secrets: DB credentials, session secret, VAPID keys (architecture.md §5.1).
# Not needed yet — scripts/test-db.sh and scripts/gate.sh derive DATABASE_URL
# themselves — but listed now so the first lane that needs a real .env does not
# fail in a worktree for a reason nobody thinks to check.
.env
.env.local
